# Backend port (Vite's frontend port is separate).
PORT=3001
# Private storage directory. Use an absolute persistent path in production.
ENQUIRY_DATA_DIR=./data
# Email recipient and sender configuration. Never commit real credentials.
ENQUIRY_TO=your-test-recipient@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
# Gmail requires an app password, not the regular account password.
SMTP_PASS=
# Defaults to SMTP_USER when blank.
SMTP_FROM=
